package example.spring.core;

import org.springframework.context.ApplicationContext;
import org.springframework.context.support.FileSystemXmlApplicationContext;

public class SpringSimpleExampleMain {

	public static void main(String[] args) {
		String filePath="./src/main/resources/spring-config.xml";
		ApplicationContext ctx;
		ctx=new FileSystemXmlApplicationContext(filePath);
		Object loadedObject=ctx.getBean("springBean");
		GreetingService gs=(GreetingService)loadedObject;
		System.out.println(gs.sayGreeting());
        System.out.println("----------------------------------");
        GreetingService gs2=new HelloService();
        System.out.println(gs2.sayGreeting());
	}

}
