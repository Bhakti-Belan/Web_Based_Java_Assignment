package com.bookshop.dao;

import java.util.List;

import org.hibernate.Session;
import org.hibernate.SessionFactory;
import org.hibernate.Transaction;
import org.hibernate.query.Query;

import com.bookshop.entity.Book;
import com.bookshop.util.HibrenateUtils;

import example.hibernate.entity.Article;
import example.hibernate.exception.ResourceNotFoundException;
import example.hibernate.utils.HibernateUtils;
import jakarta.persistence.NoResultException;

public class BookDao {

	public boolean save(Book book) {
		boolean status = false;
		try (SessionFactory factory = HibrenateUtils.getSessionFactory(); Session session = factory.openSession()) {
			Transaction tx = session.beginTransaction();
			session.persist(book);
			tx.commit();
			status = true;
		} catch (Exception e) {
			e.printStackTrace();
		}
		return status;

	}

	public List<Book> findAll() {
		List<Book> books = null;
		try (SessionFactory factory = HibrenateUtils.getSessionFactory(); Session session = factory.openSession()) {
			session.beginTransaction();
			String hql = "from Book";
			Query<Book> query = session.createQuery(hql, Book.class);
			books = query.list();

		} catch (Exception e) {
			e.printStackTrace();
		}
		return books;
	}
	public Book findByTitle(String title)
	{
		Book foundBook=null;
		try(SessionFactory factory = HibrenateUtils.getSessionFactory(); Session session = factory.openSession()) {
			String hql="select b from Book b where b.title=:bookTitle";
			foundBook =session.createQuery(hql,Book.class).setParameter("bookTitle",title).uniqueResult();
			
			
		} catch (Exception e) {
			e.printStackTrace();
		}
		return foundBook;
	}
	public boolean deleteBook(String title)
	{
		boolean status=false;
		try(SessionFactory factory=HibrenateUtils.getSessionFactory();
				Session session=factory.openSession()
					){
			
			Book book=findByTitle(title);


			if(book!=null)
			{
				Transaction tx=session.beginTransaction();
			session.remove(book);
				tx.commit();
				status=true;
				
			}
			else
			{
				throw new ResourceNotFoundException("Book with Title "+title+" not Found!!!");
			}
			}
		return status;
			
	}
	public boolean update(Book book,String title, double price, int year)
	{	boolean status=false;
		try(SessionFactory factory=HibrenateUtils.getSessionFactory();
				Session session=factory.openSession()
					){
		
			Book foundBook=findByTitle(book.getTitle());
			if(foundBook==null)
			{
				throw new ResourceNotFoundException("Book Not Found With Title "+title);
			}
			else
			{
				Transaction tx=session.beginTransaction();
				foundBook.setTitle(title);
				foundBook.setPrice(price);
				foundBook.setPublicationYear(year);
			    tx.commit();
			    status=true;
			}
}
		return status;
	}
}