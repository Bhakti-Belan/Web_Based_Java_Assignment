<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"	
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
    http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
  
  <bean id="tyreBean" class="example.spring.core.Tyre">
<property name="make" value="BrideStone"/>
<property name="type" value="Tubeless"/>
  
  </bean>
   
   <bean id="engineBean" class="example.spring.core.Engine">
  <property name="type" value="Diesel"/>
  <property name="power" value="2600 cc"/>
  </bean>
  
  
   
</beans>